# Verdict — example environment configuration.
# Copy to .env.local and edit. .env.local is gitignored and never committed.
# All paths are examples from a SIFT Workstation; nothing is hardcoded in code.

# --- Core directories ---
EVIDENCE_DIR=/cases/evidence
LOG_DIR=./logs

# --- Agent safety cap (hard limit on any agent/tool loop) ---
MAX_ITERATIONS=25

# --- Tool-adapter binary paths (swappable across SIFT versions) ---
# If a binary is unset or absent, the matching wrapper degrades gracefully.
# Values may be a bare name on PATH or an absolute path.
TOOL_MFTECMD=MFTECmd.exe
TOOL_PECMD=PECmd.exe
TOOL_AMCACHEPARSER=AmcacheParser.exe
TOOL_RECMD=RECmd.exe
TOOL_EVTXECMD=EvtxECmd.exe
TOOL_FLS=fls
TOOL_MACTIME=mactime

# --- OPTIONAL: direct-LLM mode for the benchmark harness ONLY ---
# The Verdict MCP server is model-agnostic: the agent model is chosen INSIDE
# Claude Code (the required agentic framework), never by this server. The
# default local path (Claude Code + benchmark replay/mock) needs NEITHER of the
# two vars below. Set them only if you explicitly run the benchmark harness in
# live-LLM mode. They are unused on the standard Claude Code path.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-4-8
